{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    // building
    "target": "esnext",
    "noEmit": true,
    "isolatedModules": true,

    // import/export
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // linting
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    // types
    "types": [
      "node"
    ]
  },
  "include": [
    "*.*",
    "src",
    "scripts"
  ],
}