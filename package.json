{
  "name": "eslint-config-werk85",
  "version": "10.0.0-beta.1",
  "repository": "git@github.com:werk85/eslint-config-werk85.git",
  "author": "werk85 <moin@werk85.de>",
  "license": "MIT",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "default": "./esm/index.js",
      "import": "./esm/index.js",
      "types": "./esm/index.d.ts"
    },
    "./prettier": {
      "default": "./esm/prettier.js",
      "import": "./esm/prettier.js",
      "types": "./esm/prettier.d.ts"
    },
    "./react": {
      "default": "./esm/react.js",
      "import": "./esm/react.js",
      "types": "./esm/react.d.ts"
    },
    "./fp-ts": {
      "default": "./esm/fp-ts.js",
      "import": "./esm/fp-ts.js",
      "types": "./esm/fp-ts.d.ts"
    },
    "./jest": {
      "default": "./esm/jest.js",
      "import": "./esm/jest.js",
      "types": "./esm/jest.d.ts"
    },
    "./restricted-imports": {
      "default": "./esm/restricted-imports.js",
      "import": "./esm/restricted-imports.js",
      "types": "./esm/restricted-imports.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && yarn prepare && tsx ./scripts/build.ts",
    "lint": "concurrently \"yarn:lint:*\"",
    "lint:es": "eslint .",
    "lint:tsc": "tsc -p tsconfig.json",
    "lint:madge": "madge --extensions ts --ts-config ./tsconfig.json --circular --warning src",
    "fix": "yarn lint:es --fix",
    "prepare": "rimraf dist && concurrently \"yarn:prepare:*\"",
    "prepare:esm": "tsc --project tsconfig.esm.json",
    "postinstall": "husky",
    "prepublishOnly": "tsx ./scripts/pre-publish.ts",
    "release": "yarn build && tsx ./scripts/release.ts"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-fp-ts": "^0.5.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@local/eslint-config-werk85": "./dist",
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "madge": "^8.0.0",
    "npm-check-updates": "^22.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.0",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.14.1"
}
